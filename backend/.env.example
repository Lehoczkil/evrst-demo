APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production (Resend): MAIL_MAILER=resend + RESEND_API_KEY below, and a
# From address on the verified domain, e.g.
#   MAIL_MAILER=resend
#   MAIL_FROM_ADDRESS="no-reply@evrst.hu"
#   MAIL_FROM_NAME="EVRST"

# The domain team logins are minted on: <given>.<surname>@MAIL_ORG_DOMAIN.
MAIL_ORG_DOMAIN=evrst.hu

# Where mail is actually delivered. The org address is always the login.
#   false — deliver to the member's private address (team_members.email_private),
#           falling back to the login. Use this until every member has a real
#           mailbox on MAIL_ORG_DOMAIN, so temp passwords and reset links can't
#           be sent into a void.
#   true  — deliver to the org address itself. Flip once the mailboxes are live.
MAIL_DELIVER_TO_ORG=false

# To deliver real email (temp passwords, task notifications) set
# MAIL_MAILER above to `resend` (or `postmark`) and supply the matching
# API key below. The `resend/resend-php` package is already installed
# in composer; postmark needs `composer require symfony/postmark-mailer`
# additionally. With MAIL_MAILER=log the messages just land in
# storage/logs/laravel.log.
RESEND_API_KEY=
POSTMARK_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Discord webhook URL used to ping a channel on each new member
# application. Leave blank in dev to skip Discord posts.
DISCORD_WEBHOOK_URL=

# Discord bot token (Bot scope) — used by SendDiscordDirectMessage to
# DM team members directly instead of posting to the channel webhook.
# Until this is set AND members have a numeric snowflake in
# team_members.discord_id, DM delivery is skipped and channel webhook
# pings remain the only outbound path.
DISCORD_BOT_TOKEN=
# DISCORD_API_BASE=https://discord.com/api/v10

# Onshape — generate a key pair at https://dev-portal.onshape.com → API
# keys. Translation requests run as the owner of these keys, so they
# need read access to the documents being exported.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
# ONSHAPE_BASE_URL=https://cad.onshape.com/api/v6

# Public URL of the Filament admin (used in Discord webhook payloads).
ADMIN_URL=http://localhost:8000/admin

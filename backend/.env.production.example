# ── Production env for the Docker Compose deploy ──────────────────────────
# Copy to backend/.env.production (gitignored) and fill in. Loaded by the
# backend, queue and scheduler services in ../compose.yaml.
# Generate APP_KEY:  php -r 'echo "base64:".base64_encode(random_bytes(32));'

APP_NAME="EVRST"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Single origin: the SPA, API and Filament all live here.
APP_URL=https://evrst.hu
# Only used to build admin deep-links in Discord messages (defaults to APP_URL/admin).
ADMIN_URL=https://evrst.hu/admin

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Apache listens here inside the container; Caddy proxies to backend:8080.
PORT=8080

# Database — bundled SQLite, kept on the /persistent volume across redeploys.
DB_CONNECTION=sqlite

# Sessions / cache / queue all on the database (no Redis needed at this scale).
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Mail — switch off `log` so accept-application / temp-password emails actually
# send. Resend and Postmark both have config stubs in config/services.php.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="no-reply@evrst.hu"
MAIL_FROM_NAME="${APP_NAME}"

# Optional integrations (leave blank to disable).
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=

LOG_CHANNEL=stack
LOG_LEVEL=warning

{
  "name": "evrst-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "feat": "bin/generate.ts"
  },
  "scripts": {
    "start": "vite --host",
    "dev": "vite",
    "build": "vue-tsc --noEmit --skipLibCheck && vite build",
    "preview": "vite preview --host",
    "lint:eslint": "eslint 'src/**/*.{ts,js,vue}' --no-fix",
    "lint:tsc": "vue-tsc --noEmit --skipLibCheck",
    "lint:fix": "eslint 'src/**/*.{ts,js,vue}' --fix",
    "lint:scss": "stylelint 'src/**/*.{scss,vue}'",
    "lint:scss:fix": "bun run lint:scss -- --fix",
    "lint": "bun run lint:eslint && bun run lint:scss && bun run lint:tsc",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@sentry/vue": "^10.17",
    "@vueuse/core": "^14.2.1",
    "date-fns": "^4.1",
    "motion-v": "^2.0",
    "pinia": "^3.0",
    "vue": "^3.5",
    "vue-i18n": "^11.1",
    "vue-router": "^5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21",
    "@playwright/test": "^1.59.1",
    "@rollup/plugin-strip": "^3.0",
    "@types/node": "^25.0",
    "@typescript-eslint/eslint-plugin": "^8.26",
    "@typescript-eslint/parser": "^8.26",
    "@unocss/reset": "^66.6",
    "@unocss/transformer-variant-group": "^66.6",
    "@vitejs/plugin-vue": "^6.0",
    "@vue/eslint-config-typescript": "^14.5",
    "autoprefixer": "^10.4",
    "eslint": "^9.21",
    "eslint-plugin-vue": "^10.0",
    "postcss": "^8.5",
    "prettier": "^3.5",
    "rimraf": "^6.0",
    "rollup-plugin-visualizer": "^7.0",
    "sass": "^1.85",
    "stylelint": "^17.0",
    "stylelint-config-html": "^1.1",
    "stylelint-config-standard-scss": "^17.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-order": "^8.1",
    "stylelint-prettier": "^5.0",
    "stylelint-scss": "^7.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.26",
    "unocss": "^66.6",
    "unplugin-auto-import": "^21.0",
    "unplugin-vue-components": "^32.0",
    "vite": "^7.3",
    "vite-plugin-vue-devtools": "^8.0",
    "vite-plugin-webfont-dl": "^3.10",
    "vue-eslint-parser": "^10.1",
    "vue-tsc": "^3.1"
  },
  "engines": {
    "node": "24.14.0"
  }
}

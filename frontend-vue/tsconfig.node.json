{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vite/**/*.ts",
    "uno.config.ts",
    "eslint.config.js",
    "stylelint.config.js",
    "postcss.config.js",
    "playwright.config.ts",
    "bin/**/*.ts"
  ]
}

# Repo-root env for `docker compose` (the single-domain deploy stack).
# Copy to .env and edit. Real backend secrets live in backend/.env.production.

# Domain Caddy serves and requests a TLS cert for. Space-separate to add www:
#   SITE_ADDRESS="evrst.hu www.evrst.hu"
# Leave as localhost for a local `docker compose up` (self-signed cert).
SITE_ADDRESS=evrst.hu

# Which built images this box runs. The deploy job rewrites IMAGE_TAG to the
# commit SHA it just pushed; `latest` is the fallback for a hand-built stack.
# Rolling back = put the previous SHA here and `docker compose up -d`.
IMAGE_TAG=latest
